{
	"name": "onlineornot",
	"version": "1.7.11",
	"description": "Command-line interface for OnlineOrNot",
	"keywords": [
		"uptime monitoring"
	],
	"homepage": "https://github.com/OnlineOrNot/onlineornot#readme",
	"bugs": {
		"url": "https://github.com/OnlineOrNot/onlineornot/issues"
	},
	"license": "FSL-1.1-Apache-2.0",
	"author": "Max Rozen <max@onlineornot.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/OnlineOrNot/onlineornot.git"
	},
	"bin": {
		"onlineornot": "./bin/onlineornot.js"
	},
	"files": [
		"onlineornot-dist",
		"bin"
	],
	"main": "onlineornot-dist/cli.js",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "pnpm run clean && pnpm run bundle",
		"build:sea": "pnpm run check:cli && bash scripts/build-sea.sh",
		"bundle": "pnpm run check:cli && node -r esbuild-register scripts/bundle.ts",
		"clean": "rimraf dist sea",
		"prepublishOnly": "SOURCEMAPS=false pnpm run build",
		"start": "pnpm run bundle && cross-env NODE_OPTIONS=--enable-source-maps ./bin/onlineornot.js",
		"check:type": "tsc --noEmit && pnpm run check:generator",
		"test": "vitest",
		"test:ci": "vitest run",
		"verify:release-patches": "tsx scripts/verify-release-patches.mts",
		"generate:cli": "node scripts/generate-cli.mjs",
		"check:cli": "node scripts/generate-cli.mjs --check",
		"check:generator": "tsc --project generator/tsconfig.json --noEmit"
	},
	"dependencies": {
		"@onlineornot/api": "workspace:^",
		"chalk": "^6.0.0",
		"cli-table3": "^0.6.5",
		"conf": "^15.1.0",
		"esbuild": "^0.28.2",
		"open": "^11.0.2",
		"supports-color": "^11.0.0",
		"update-check": "^1.5.4",
		"yargs": "^17.7.3",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@bytecodealliance/jco": "1.37.0",
		"@cloudflare/forge": "https://pkg.pr.new/cloudflare/forge/@cloudflare/forge@45c005a259a5507763d866e12d1e907af6ce745d",
		"@types/node": "^22.19.15",
		"@types/yargs": "^17.0.35",
		"binpatch": "0.4.2",
		"cross-env": "^10.1.0",
		"esbuild-register": "^3.6.0",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.13",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22"
	}
}
