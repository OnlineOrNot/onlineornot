{
	"name": "@onlineornot/api",
	"version": "0.0.0",
	"description": "Generated TypeScript client for the OnlineOrNot REST API",
	"keywords": [
		"onlineornot",
		"api",
		"sdk",
		"uptime monitoring",
		"typescript"
	],
	"homepage": "https://github.com/OnlineOrNot/onlineornot/tree/main/packages/api#readme",
	"bugs": {
		"url": "https://github.com/OnlineOrNot/onlineornot/issues"
	},
	"license": "MIT",
	"author": "Max Rozen <max@onlineornot.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OnlineOrNot/onlineornot.git",
		"directory": "packages/api"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"check:generated": "node scripts/generate.mjs --check",
		"check:type": "tsc --noEmit",
		"clean": "rimraf dist",
		"generate": "node scripts/generate.mjs",
		"schema:update": "node scripts/update-schema.mjs",
		"prepack": "pnpm run build",
		"test": "pnpm run build && vitest run",
		"test:ci": "vitest run"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.99.0",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "5.9.3",
		"vitest": "^4.1.11",
		"@types/node": "^22.19.15"
	}
}
