{
	"name": "onlineornot-root",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for onlineornot and associated packages",
	"homepage": "https://github.com/onlineornot/onlineornot#readme",
	"bugs": {
		"url": "https://github.com/cloudflare/onlineornot/issues"
	},
	"license": "FSL-1.1-Apache-2.0",
	"author": "max@onlineornot.com",
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"check": "run-p check:* --aggregate-output --continue-on-error",
		"check:format": "oxfmt --check .",
		"check:lint": "oxlint --deny-warnings",
		"check:type": "pnpm -r --if-present run check:type",
		"fix": "oxfmt --write . && oxlint --fix",
		"test": "pnpm --filter onlineornot run clean && pnpm run build && pnpm -r --if-present run test",
		"test:ci": "pnpm -r --if-present run test:ci",
		"prepare": "husky"
	},
	"dependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@types/node": "^22.19.15",
		"esbuild-register": "^3.6.0",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.1.3",
		"vitest": "^4.1.11"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.81.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.66.0",
		"oxlint": "1.81.0",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{js,ts,tsx,jsx,mjs,cjs,mts}": [
			"oxfmt --write",
			"oxlint --fix"
		],
		"*.{json,md,yaml,yml}": [
			"oxfmt --write"
		]
	},
	"engines": {
		"node": ">=22.15.0"
	},
	"volta": {
		"node": "22.16.0"
	}
}
